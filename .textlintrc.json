{
	"filters": {},
	"rules": {
		"preset-jtf-style": {
			"3.1.1.全角文字と半角文字の間": false,
			"4.3.1.丸かっこ（）": false,
			"4.2.7.コロン(：)": false
		},
		"preset-ja-spacing": {
			"ja-space-between-half-and-full-width": {
				"space": "always"
			},
			"ja-space-around-link": {
				"before": true,
				"after": true
			},
			"ja-space-around-code": {
				"before": true,
				"after": true
			}
		},
		"no-mix-dearu-desumasu": {
			"preferInHeader": "",
			"preferInBody": "ですます",
			"preferInList": "ですます",
			"strict": true
		}
	}
}
