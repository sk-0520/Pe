primary:
	TOKEN_KIND_WORD
	TOKEN_KIND_LITERAL_INTEGER
	TOKEN_KIND_LITERAL_DECIMAL
	string

factor:
	TOKEN_KIND_BRACKET_LPAREN expression TOKEN_KIND_BRACKET_RPAREN
	primary

term:
	term TOKEN_KIND_OP_STAR factor
	term TOKEN_KIND_OP_SLASH factor
	factor

expression:
	expression TOKEN_KIND_OP_PLUS term
	expression TOKEN_KIND_OP_MINUS term
	term

string:
	TOKEN_KIND_LITERAL_SSTRING
	TOKEN_KIND_LITERAL_DSTRING
	TOKEN_KIND_LITERAL_BSTRING






